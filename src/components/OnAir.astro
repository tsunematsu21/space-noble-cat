---
---

<div class="grid gap-5 md:grid-cols-2">
  <div
    class="relative overflow-hidden rounded-2xl border border-yellow-200/20 bg-gradient-to-br from-yellow-200/10 to-transparent p-6 shadow-xl shadow-black/20 md:p-8"
  >
    <div
      aria-hidden="true"
      class="absolute top-0 right-0 text-8xl text-white/5"
    >
      ◉
    </div>
    <p class="relative space-y-3">
      <small
        class="inline-flex rounded-full bg-yellow-200 px-3 py-1 text-xs font-bold tracking-widest text-slate-950"
        >ON AIR</small
      >
      <span class="block text-sm text-white/60">テレビ東都</span>
      <span class="block text-2xl font-bold md:text-3xl">「ANIFICT」枠</span>
      <span class="block text-xl font-kaisei text-yellow-200 md:text-2xl"
        >不定期放送中</span
      >
    </p>
  </div>
  <div
    class="relative overflow-hidden rounded-2xl border border-cyan-200/20 bg-gradient-to-br from-cyan-200/10 to-transparent p-6 shadow-xl shadow-black/20 md:p-8"
  >
    <div
      aria-hidden="true"
      class="absolute top-0 right-0 text-8xl text-white/5"
    >
      ▷
    </div>
    <p class="relative space-y-3">
      <small
        class="inline-flex rounded-full bg-cyan-100 px-3 py-1 text-xs font-bold tracking-widest text-slate-950"
        >STREAMING</small
      >
      <span class="block text-sm text-white/60">動画未配信サービス</span>
      <span class="block text-2xl font-bold md:text-3xl">「MIRENAI」</span>
      <span class="block text-xl font-kaisei text-cyan-100 md:text-2xl"
        >順次配信中</span
      >
    </p>
  </div>
</div>
