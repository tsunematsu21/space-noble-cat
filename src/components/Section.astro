---
interface Props {
  id?: string;
  title: string;
  subtitle?: string;
}
const { id, title, subtitle } = Astro.props;
---

<section
  id={id}
  class="relative max-w-5xl mx-auto overflow-hidden rounded-3xl border border-white/10 bg-slate-950/40 px-6 py-12 shadow-2xl shadow-purple-950/30 backdrop-blur-md scroll-mt-8 md:px-12 md:py-16"
>
  <div
    aria-hidden="true"
    class="absolute -top-24 -right-24 size-64 rounded-full bg-purple-500/10 blur-3xl"
  ></div>
  <header class="relative text-yellow-200 font-kaisei text-center space-y-3">
    <p class="text-xs uppercase tracking-[0.35em] md:text-sm">{subtitle}</p>
    <div class="flex items-center justify-center gap-4">
      <span
        class="h-px w-8 bg-gradient-to-r from-transparent to-yellow-200/60 md:w-20"
      ></span>
      <h2 class="font-black text-2xl tracking-wide md:text-4xl">{title}</h2>
      <span
        class="h-px w-8 bg-gradient-to-l from-transparent to-yellow-200/60 md:w-20"
      ></span>
    </div>
  </header>
  <div class="relative mt-12 space-y-8">
    <slot />
  </div>
  {Astro.slots.has("footer") && (
    <footer class="relative mt-12 border-t border-white/10 pt-10">
      <slot name="footer" />
    </footer>
  )}
</section>
