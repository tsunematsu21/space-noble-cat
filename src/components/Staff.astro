---
import { getCollection } from "astro:content";
import LinkButton from "@components/LinkButton.astro";

const [allStaff, comments] = await Promise.all([
  getCollection("staff"),
  getCollection("comments"),
]);
---

<dl class="grid grid-cols-1 md:grid-cols-3 gap-8">
  {allStaff.map((staff) => {
    const comment = comments.find((entry) => entry.data.staff?.id === staff.id);

    return (
      <div
        class:list={["text-center", staff.data.colSpan ? "md:col-span-3" : ""]}
      >
        <dt class="text-sm opacity-50">{staff.data.role}</dt>
        <dd class="text-xl space-y-1">
          <p class="flex flex-col gap-1">
            <span>{staff.data.name}</span>
            {staff.data.note && (
              <span class="text-sm">{staff.data.note}</span>
            )}
          </p>
          {comment && (
            <LinkButton to={`/comments/${comment.id}`}>
              COMMENT
            </LinkButton>
          )}
        </dd>
      </div>
    );
  })}
</dl>
