---
import { getCollection } from "astro:content";
import LinkButton from "@components/LinkButton.astro";

const [allStaff, comments] = await Promise.all([
  getCollection("staff"),
  getCollection("comments"),
]);
---

<dl class="grid grid-cols-1 md:grid-cols-3 gap-8">
  {allStaff.map((staff) => {
    const comment = comments.find((entry) => entry.data.staff?.id === staff.id);

    return (
      <div
        class:list={[
          "rounded-2xl border border-white/10 bg-white/5 p-5 text-center shadow-lg shadow-black/10",
          staff.data.colSpan ? "md:col-span-3" : "",
        ]}
      >
        <dt class="text-xs tracking-widest text-white/50">{staff.data.role}</dt>
        <dd class="mt-2 space-y-4 text-xl">
          <p class="flex flex-col gap-1">
            <span class="font-kaisei">{staff.data.name}</span>
            {staff.data.note && (
              <span class="text-sm text-white/70">{staff.data.note}</span>
            )}
          </p>
          {comment && (
            <LinkButton to={`/comments/${comment.id}`}>
              COMMENT
            </LinkButton>
          )}
        </dd>
      </div>
    );
  })}
</dl>
