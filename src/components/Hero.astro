---
import { Image } from "astro:assets";
import KeyVisual from "@assets/KeyVisual.png";
import Logo from "@assets/Logo.png";
import { Content as Catchphrase } from "@contents/Catchphrase.md";
---

<div class="relative max-w-7xl mx-auto">
  <h1>
    <Image
      src={Logo}
      alt="宇宙貴族猫 - Space Noble Cat"
      class="md:absolute md:max-w-2xl md:bottom-0 md:left-0 md:right-0 mx-auto z-50"
    />
  </h1>
  <div class="relative">
    <Image src={KeyVisual} alt="KeyVisual" class="w-full" />
    <div
      class="absolute top-0 right-0 mx-auto p-4 md:p-16 text-xs md:text-2xl font-kaisei"
    >
      <Catchphrase />
    </div>
  </div>
</div>
