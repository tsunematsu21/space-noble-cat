---
import { Image } from "astro:assets";
import KeyVisual from "@assets/KeyVisual.png";
import Logo from "@assets/Logo.png";
import { Content as Catchphrase } from "@contents/Catchphrase.md";
---

<div class="max-w-7xl mx-auto px-4 md:px-8">
  <div
    class="relative overflow-hidden rounded-b-3xl border-x border-b border-white/10 bg-black/20 shadow-2xl shadow-purple-950/40"
  >
    <h1>
      <Image
        src={Logo}
        alt="宇宙貴族猫 - Space Noble Cat"
        class="relative mx-auto drop-shadow-2xl md:absolute md:inset-x-0 md:bottom-2 md:max-w-2xl md:z-20"
      />
    </h1>
    <div class="relative">
      <Image src={KeyVisual} alt="宇宙貴族猫のキービジュアル" class="w-full" />
      <div
        aria-hidden="true"
        class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-purple-950/20"
      ></div>
      <div
        class="absolute top-0 right-0 p-4 text-xs font-kaisei leading-relaxed drop-shadow-lg md:p-16 md:text-2xl"
      >
        <Catchphrase />
      </div>
    </div>
  </div>
</div>
