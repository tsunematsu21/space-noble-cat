---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";

const characters = await getCollection("characters");
---

<ul class="grid grid-cols-1 md:grid-cols-3 gap-8">
  {characters.map((character) =>(
    <li class="flex items-start justify-center">
      <a href={`/characters/${character.id}`} class="rounded-md overflow-hidden">
        <span class="block relative">
          <span class="text-sm bg-black/50 p-2 w-full text-center absolute bottom-0">
            {character.data.name}
            {character.data.peerage}
          </span>
          <Image src={character.data.image} alt={character.data.name} width="512" class="w-full aspect-square md:w-64 w-64 object-contain bg-gray-500" />
        </span>
      </a>
    </li>
  ))}
</ul>
