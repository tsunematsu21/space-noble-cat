---
import { getCollection } from "astro:content";
import LinkButton from "@components/LinkButton.astro";

const [casts, comments] = await Promise.all([
  getCollection("casts"),
  getCollection("comments"),
]);
---

<dl class="grid grid-cols-1 md:grid-cols-3 gap-8">
  {casts.map((cast) => {
    const comment = comments.find((entry) => entry.data.cast?.id === cast.id);

    return (
      <div
        class="rounded-2xl border border-white/10 bg-white/5 p-6 text-center shadow-lg shadow-black/10"
      >
        <dt class="text-xs tracking-widest text-white/50">{cast.data.role}</dt>
        <dd class="mt-2 space-y-4 text-xl">
          <p class="font-kaisei">{cast.data.name}</p>
          {comment && (
            <LinkButton to={`/comments/${comment.id}`}>
              COMMENT
            </LinkButton>
          )}
        </dd>
      </div>
    );
  })}
</dl>
