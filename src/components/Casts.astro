---
import { getCollection } from "astro:content";
import LinkButton from "@components/LinkButton.astro";

const [casts, comments] = await Promise.all([
  getCollection("casts"),
  getCollection("comments"),
]);
---

<dl class="grid grid-cols-1 md:grid-cols-3 gap-8">
  {casts.map((cast) => {
    const comment = comments.find((entry) => entry.data.cast?.id === cast.id);

    return (
      <div class="text-center">
        <dt class="text-sm opacity-50">{cast.data.role}</dt>
        <dd class="text-xl space-y-2">
          <p>{cast.data.name}</p>
          {comment && (
            <LinkButton to={`/comments/${comment.id}`}>
              COMMENT
            </LinkButton>
          )}
        </dd>
      </div>
    );
  })}
</dl>
